<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>

    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />


    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.300" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Quartz" Version="3.19.1" />
    <PackageReference Include="Quartz.AspNetCore" Version="3.19.1" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.19.1" />
    <PackageReference Include="SpreadCheetah" Version="1.28.0" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckBuilt Include="Styles/app.css" Set="Css" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Views\Dashboard\NewFolder\" />
    <Folder Include="wwwroot\images\" />
  </ItemGroup>

<Target Name="BuildTailwind" BeforeTargets="Build">
  <Exec Command="npm run css:build" WorkingDirectory="$(ProjectDir)" />
</Target>

</Project>