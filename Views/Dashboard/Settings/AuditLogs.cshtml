@{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    if (!role.Equals("Super Admin", StringComparison.OrdinalIgnoreCase) &&
        !role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
    {
        Context.Response.Redirect("/Dashboard/Index");
        return;
    }
}

@{
    ViewData["Title"] = "Audit Logs";
    ViewData["ActivePage"] = "AuditLogs";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes fadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(32px) scale(0.98); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .fade-up { opacity: 0; animation: fadeUp 0.45s ease forwards; }
    .fade-up-1 { animation-delay: 0.05s; }
    .fade-up-2 { animation-delay: 0.15s; }
    .fade-up-3 { animation-delay: 0.25s; }

    .log-row { transition: background 0.15s ease; }
    .log-row:hover { background: var(--color-surface, #f8fafc); }

    @@keyframes spin { to { transform: rotate(360deg); } }
    .spinner { animation: spin 0.7s linear infinite; }

    .page-btn {
        min-width: 32px; height: 32px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 8px; font-size: 0.75rem; font-weight: 500;
        border: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        background: transparent;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .page-btn:hover:not(:disabled) {
        background: var(--color-surface);
        color: var(--color-text-primary);
    }
    .page-btn.active {
        background: var(--color-brand-500, #3b82f6);
        color: #fff;
        border-color: var(--color-brand-500, #3b82f6);
    }
    .page-btn:disabled { opacity: 0.35; cursor: not-allowed; }

    #detailModal {
        display: none;
        animation: fadeIn 0.15s ease forwards;
    }
    #detailModal.open { display: flex; }
    #detailBox {
        animation: slideUp 0.22s cubic-bezier(0.34, 1.4, 0.64, 1) forwards;
    }

    .detail-row { display: grid; grid-template-columns: 140px 1fr; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--color-border); }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { font-size: 0.75rem; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.02em; padding-top: 2px; }
    .detail-value { font-size: 0.8125rem; color: var(--color-text-primary); word-break: break-word; }
</style>

@* ── Page header ── *@
<div class="flex items-center justify-between mb-6 fade-up fade-up-1">
    <div>
        <h1 class="text-text-primary text-2xl font-semibold">Audit Logs</h1>
        <p class="text-text-muted text-sm mt-0.5">A full record of system events and user activity.</p>
    </div>
    <button onclick="exportCsv()"
            class="flex items-center gap-2 px-4 py-2.5 border border-border hover:border-blue-300
                   text-text-secondary hover:text-blue-600 text-sm font-medium rounded-xl
                   transition-colors bg-surface-card">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Export CSV
    </button>
</div>

@* ── Filters row ── *@
<div class="bg-surface-card border border-border rounded-2xl px-5 py-4 mb-4 fade-up fade-up-2">
    <div class="flex flex-wrap gap-3 items-end">

        @* Search *@
        <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-medium text-text-muted mb-1.5">Search</label>
            <div class="relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-text-muted pointer-events-none"
                     fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <input id="searchInput" type="text" placeholder="Search user, action, resource, IP..."
                       oninput="onSearchInput()"
                       class="w-full pl-8 pr-4 py-2 bg-surface border border-border rounded-xl text-sm
                              text-text-primary placeholder-text-muted focus:outline-none
                              focus:border-blue-400 focus:ring-2 focus:ring-blue-100 transition-colors" />
            </div>
        </div>

        @* Action filter *@
        <div class="min-w-[180px]">
            <label class="block text-xs font-medium text-text-muted mb-1.5">Action</label>
            <select id="actionFilter" onchange="applyFilters()"
                    class="w-full px-3 py-2 bg-surface border border-border rounded-xl text-sm
                           text-text-primary focus:outline-none focus:border-blue-400
                           focus:ring-2 focus:ring-blue-100 transition-colors">
                <option value="">All Actions</option>
            </select>
        </div>

        @* Date from *@
        <div class="min-w-[150px]">
            <label class="block text-xs font-medium text-text-muted mb-1.5">Date From</label>
            <input id="dateFrom" type="date" onchange="applyFilters()"
                   class="w-full px-3 py-2 bg-surface border border-border rounded-xl text-sm
                          text-text-primary focus:outline-none focus:border-blue-400
                          focus:ring-2 focus:ring-blue-100 transition-colors" />
        </div>

        @* Date to *@
        <div class="min-w-[150px]">
            <label class="block text-xs font-medium text-text-muted mb-1.5">Date To</label>
            <input id="dateTo" type="date" onchange="applyFilters()"
                   class="w-full px-3 py-2 bg-surface border border-border rounded-xl text-sm
                          text-text-primary focus:outline-none focus:border-blue-400
                          focus:ring-2 focus:ring-blue-100 transition-colors" />
        </div>

        @* Clear *@
        <div>
            <button onclick="clearFilters()"
                    class="px-4 py-2 text-sm text-text-secondary border border-border rounded-xl
                           hover:bg-surface hover:text-text-primary transition-colors">
                Clear
            </button>
        </div>

    </div>
</div>

@* ── Table card ── *@
<div class="bg-surface-card border border-border rounded-2xl shadow-sm overflow-hidden fade-up fade-up-3">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-border bg-surface">
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide">User</th>
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide">Action</th>
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide">Date &amp; Time</th>
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide">Details</th>
                </tr>
            </thead>
            <tbody id="logsTableBody">
                <tr>
                    <td colspan="4" class="text-center py-12 text-text-muted">
                        <svg class="w-5 h-5 mx-auto mb-2 spinner text-blue-400"
                             fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                        </svg>
                        <span class="text-xs">Loading audit logs...</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @* ── Footer: count + pagination ── *@
    <div class="px-5 py-3 border-t border-border bg-surface flex flex-wrap items-center justify-between gap-3">
        <span id="logCount" class="text-xs text-text-muted">--</span>
        <div id="pagination" class="flex items-center gap-1"></div>
    </div>
</div>

@* ============== DETAIL MODAL ============== *@
<div id="detailModal"
     class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm items-center justify-center px-4">
    <div id="detailBox"
         class="bg-surface-card border border-border rounded-2xl shadow-xl w-full max-w-lg px-6 py-6 max-h-[85vh] overflow-y-auto">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-text-primary font-semibold text-base">Audit Log Details</h3>
            <button onclick="closeDetail()" class="text-text-muted hover:text-text-primary transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M18 6 6 18M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <div id="detailBody">
            <div class="text-center py-10 text-text-muted">
                <svg class="w-5 h-5 mx-auto mb-2 spinner text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                </svg>
                <span class="text-xs">Loading details...</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── State ────────────────────────────────────────────────────────────────
    // Pagination and filtering now happen server-side (Dashboard/Settings/AuditLogs/GetAll),
    // instead of pulling every row and paginating in JS.
    const PAGE_SIZE = 25;
    let currentPage  = 1;
    let totalRecords = 0;
    let totalPages   = 1;
    let currentLogs  = [];   // rows for the currently displayed page only
    let searchDebounceTimer = null;

    // ── Boot ─────────────────────────────────────────────────────────────────
    async function init() {
        await loadActions();
        await loadLogs();
    }

    // ── Populate action dropdown ────────────────────────────────────────────
    // Uses the dedicated GetActions endpoint so the dropdown always reflects
    // every distinct action/event in the table, independent of pagination.
    async function loadActions() {
        try {
            const res = await fetch('/Dashboard/Settings/AuditLogs/GetActions');
            if (!res.ok) throw new Error();
            const actions = await res.json();

            const sel = document.getElementById('actionFilter');
            actions.forEach(a => {
                const opt = document.createElement('option');
                opt.value = a;
                opt.textContent = a;
                sel.appendChild(opt);
            });
        } catch {
            // Non-fatal: filter dropdown just stays at "All Actions".
        }
    }

    // ── Build query string from current filter/pagination state ───────────
    function buildQuery(overridePageSize) {
        const search   = document.getElementById('searchInput').value.trim();
        const action   = document.getElementById('actionFilter').value;
        const dateFrom = document.getElementById('dateFrom').value;
        const dateTo   = document.getElementById('dateTo').value;

        const params = new URLSearchParams();
        params.set('page', currentPage);
        params.set('pageSize', overridePageSize || PAGE_SIZE);
        if (search)   params.set('search', search);
        if (action)   params.set('action', action);
        if (dateFrom) params.set('dateFrom', dateFrom);
        if (dateTo)   params.set('dateTo', dateTo);
        return params.toString();
    }

    // ── Fetch current page from the server ─────────────────────────────────
    async function loadLogs() {
        const tbody = document.getElementById('logsTableBody');
        tbody.innerHTML = `
            <tr>
                <td colspan="4" class="text-center py-12 text-text-muted">
                    <svg class="w-5 h-5 mx-auto mb-2 spinner text-blue-400"
                         fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                    </svg>
                    <span class="text-xs">Loading audit logs...</span>
                </td>
            </tr>`;

        try {
            const res = await fetch(`/Dashboard/Settings/AuditLogs/GetAll?${buildQuery()}`);
            if (!res.ok) throw new Error();
            const payload = await res.json();

            currentLogs  = payload.data ?? [];
            totalRecords = payload.total ?? currentLogs.length;
            totalPages   = payload.totalPages ?? 1;
            currentPage  = payload.page ?? currentPage;

            renderTable();
        } catch {
            tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="text-center py-12 text-text-muted text-xs">
                        Failed to load audit logs. Please refresh the page.
                    </td>
                </tr>`;
            document.getElementById('logCount').textContent = '--';
            document.getElementById('pagination').innerHTML = '';
        }
    }

    // ── Filter changes: reset to page 1 and re-fetch ───────────────────────
    function applyFilters() {
        currentPage = 1;
        loadLogs();
    }

    // Debounce free-text search so we don't hit the server on every keystroke.
    function onSearchInput() {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(applyFilters, 350);
    }

    function clearFilters() {
        document.getElementById('searchInput').value  = '';
        document.getElementById('actionFilter').value = '';
        document.getElementById('dateFrom').value     = '';
        document.getElementById('dateTo').value       = '';
        applyFilters();
    }

    // ── Render table for the currently loaded page ─────────────────────────
    function renderTable() {
        const tbody   = document.getElementById('logsTableBody');
        const countEl = document.getElementById('logCount');

        countEl.textContent = totalRecords === 0
            ? 'No records'
            : `${totalRecords} record${totalRecords !== 1 ? 's' : ''} total`;

        if (currentLogs.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="text-center py-12 text-text-muted text-xs">
                        No audit logs match your filters.
                    </td>
                </tr>`;
            renderPagination();
            return;
        }

        tbody.innerHTML = currentLogs.map(l => {
            const dateStr = l.eventDate
                ? new Date(l.eventDate).toLocaleString('en-GB', {
                      day: '2-digit', month: 'short', year: 'numeric',
                      hour: '2-digit', minute: '2-digit', second: '2-digit'
                  })
                : '--';

            // ── User cell ──────────────────────────────────────────────────
            // Structured logs have userEmail; legacy logs show userId.
            const userCell = l.userEmail
                ? `<div class="font-medium text-text-primary text-xs">${escHtml(l.userEmail)}</div>`
                : l.userId != null
                    ? `<span class="font-mono bg-surface border border-border px-1.5 py-0.5 rounded text-text-muted text-xs">#${l.userId}</span>`
                    : `<span class="text-text-muted text-xs">System</span>`;

            // ── Action cell ────────────────────────────────────────────────
            // Structured logs: show action badge. Legacy logs: show full event string.
            const actionBadge = l.action
                ? getActionBadge(l.action)
                : getActionBadge(l.event);

            const actionCell = l.action
                ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border ${actionBadge.classes}">
                       ${escHtml(l.action)}
                   </span>`
                : `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border ${actionBadge.classes}
                               max-w-[260px] truncate" title="${escHtml(l.event || '')}">
                       ${escHtml(l.event || '--')}
                   </span>`;

            return `
            <tr class="log-row border-b border-border last:border-0">
                <td class="px-5 py-3">${userCell}</td>
                <td class="px-5 py-3">${actionCell}</td>
                <td class="px-5 py-3 text-text-secondary text-xs whitespace-nowrap">${dateStr}</td>
                <td class="px-5 py-3">
                    <button onclick="viewDetail(${l.id})"
                            class="text-xs px-2.5 py-1.5 rounded-lg border border-border
                                   text-text-secondary hover:border-blue-300 hover:text-blue-600
                                   hover:bg-blue-50 transition-colors">
                        View
                    </button>
                </td>
            </tr>`;
        }).join('');

        renderPagination();
    }

    // ── Action badge colour by keyword ────────────────────────────────────
    function getActionBadge(action) {
        const a = (action || '').toLowerCase();
        if (a.includes('login') || a.includes('sign in') || a.includes('auth'))
            return { classes: 'bg-green-50 text-green-700 border-green-200' };
        if (a.includes('logout') || a.includes('sign out'))
            return { classes: 'bg-slate-50 text-slate-600 border-slate-200' };
        if (a.includes('delete') || a.includes('remove') || a.includes('error') || a.includes('fail'))
            return { classes: 'bg-red-50 text-red-700 border-red-200' };
        if (a.includes('create') || a.includes('add') || a.includes('register'))
            return { classes: 'bg-blue-50 text-blue-700 border-blue-200' };
        if (a.includes('update') || a.includes('edit') || a.includes('change') || a.includes('reset') || a.includes('password'))
            return { classes: 'bg-amber-50 text-amber-700 border-amber-200' };
        if (a.includes('scan') || a.includes('search') || a.includes('check'))
            return { classes: 'bg-purple-50 text-purple-700 border-purple-200' };
        return { classes: 'bg-surface text-text-muted border-border' };
    }

    // ── Pagination (driven by server-reported total/totalPages) ───────────
    function renderPagination() {
        const el = document.getElementById('pagination');
        if (totalPages <= 1) { el.innerHTML = ''; return; }

        const MAX_VISIBLE = 5;
        let pages = [];

        if (totalPages <= MAX_VISIBLE + 2) {
            pages = Array.from({ length: totalPages }, (_, i) => i + 1);
        } else {
            pages = [1];
            let start = Math.max(2, currentPage - 1);
            let end   = Math.min(totalPages - 1, currentPage + 1);

            if (currentPage <= 3)               end   = Math.min(totalPages - 1, 4);
            if (currentPage >= totalPages - 2)  start = Math.max(2, totalPages - 3);

            if (start > 2)             pages.push('...');
            for (let i = start; i <= end; i++) pages.push(i);
            if (end < totalPages - 1)  pages.push('...');
            pages.push(totalPages);
        }

        el.innerHTML = `
            <button class="page-btn" onclick="goPage(${currentPage - 1})"
                    ${currentPage === 1 ? 'disabled' : ''}>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M15 18l-6-6 6-6"/>
                </svg>
            </button>
            ${pages.map(p => p === '...'
                ? `<span class="page-btn cursor-default border-0 text-text-muted">...</span>`
                : `<button class="page-btn ${p === currentPage ? 'active' : ''}"
                           onclick="goPage(${p})">${p}</button>`
            ).join('')}
            <button class="page-btn" onclick="goPage(${currentPage + 1})"
                    ${currentPage === totalPages ? 'disabled' : ''}>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M9 18l6-6-6-6"/>
                </svg>
            </button>`;
    }

    function goPage(p) {
        if (p < 1 || p > totalPages || p === currentPage) return;
        currentPage = p;
        loadLogs();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ── Detail modal ──────────────────────────────────────────────────────
    async function viewDetail(id) {
        openDetailModal();
        document.getElementById('detailBody').innerHTML = `
            <div class="text-center py-10 text-text-muted">
                <svg class="w-5 h-5 mx-auto mb-2 spinner text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                </svg>
                <span class="text-xs">Loading details...</span>
            </div>`;

        try {
            const res = await fetch(`/Dashboard/Settings/AuditLogs/GetById/${id}`);
            if (!res.ok) throw new Error();
            const log = await res.json();
            renderDetail(log);
        } catch {
            document.getElementById('detailBody').innerHTML = `
                <div class="text-center py-10 text-red-600 text-xs">
                    Failed to load audit log details. Please try again.
                </div>`;
        }
    }

    function renderDetail(l) {
        const dateStr = l.eventDate
            ? new Date(l.eventDate).toLocaleString('en-GB', {
                  day: '2-digit', month: 'short', year: 'numeric',
                  hour: '2-digit', minute: '2-digit', second: '2-digit'
              })
            : '--';

        const rows = [
            ['ID', l.id],
            ['User Email', l.userEmail || '—'],
            ['User ID', l.userId != null ? `#${l.userId}` : '—'],
            ['Action', l.action || '—'],
            ['Resource', l.resourceName || '—'],
            ['IP Address', l.ipAddress || '—'],
            ['Page / URL', l.pageUrl || '—'],
            ['Event (legacy)', l.event || '—'],
            ['Date & Time', dateStr]
        ];

        document.getElementById('detailBody').innerHTML = rows.map(([label, value]) => `
            <div class="detail-row">
                <div class="detail-label">${escHtml(label)}</div>
                <div class="detail-value">${escHtml(String(value))}</div>
            </div>
        `).join('');
    }

    function openDetailModal() {
        document.getElementById('detailModal').classList.add('open');
    }

    function closeDetail() {
        document.getElementById('detailModal').classList.remove('open');
    }

    document.getElementById('detailModal').addEventListener('click', function(e) {
        if (e.target === this) closeDetail();
    });

    // ── CSV Export ────────────────────────────────────────────────────────
    // Exports every row matching the current filters (not just the visible page),
    // by requesting the full filtered result set from the server in one page.
    async function exportCsv() {
        try {
            const query = buildQuery(Math.max(totalRecords, 1));
            const res = await fetch(`/Dashboard/Settings/AuditLogs/GetAll?${query}`);
            if (!res.ok) throw new Error();
            const payload = await res.json();
            const rows = payload.data ?? [];

            if (rows.length === 0) return;

            const headers = ['ID', 'User Email', 'User ID', 'Action', 'Resource', 'IP Address', 'Page URL', 'Event (Legacy)', 'Event Date'];
            const csvRows = rows.map(l => [
                l.id,
                csvEsc(l.userEmail),
                l.userId ?? '',
                csvEsc(l.action),
                csvEsc(l.resourceName),
                csvEsc(l.ipAddress),
                csvEsc(l.pageUrl),
                csvEsc(l.event),
                l.eventDate ? new Date(l.eventDate).toISOString() : ''
            ]);
            const csv  = [headers, ...csvRows].map(r => r.join(',')).join('\n');
            const blob = new Blob([csv], { type: 'text/csv' });
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href     = url;
            a.download = `audit-logs-${new Date().toISOString().slice(0, 10)}.csv`;
            a.click();
            URL.revokeObjectURL(url);
        } catch {
            alert('Failed to export audit logs. Please try again.');
        }
    }

    function csvEsc(val) {
        const s = String(val ?? '');
        return s.includes(',') || s.includes('"') || s.includes('\n')
            ? `"${s.replace(/"/g, '""')}"`
            : s;
    }

    // ── HTML escape ───────────────────────────────────────────────────────
    function escHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    init();
</script>
}
