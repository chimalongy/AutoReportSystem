@{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var isSuperAdmin = role.Equals("Super Admin", StringComparison.OrdinalIgnoreCase);
}

@{
    ViewData["Title"] = "Reports";
    ViewData["ActivePage"] = "Reports";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes fadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(32px) scale(0.98); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .fade-up { opacity: 0; animation: fadeUp 0.45s ease forwards; }
    .fade-up-1 { animation-delay: 0.05s; }
    .fade-up-2 { animation-delay: 0.15s; }
    .fade-up-3 { animation-delay: 0.25s; }

    .report-row { transition: background 0.15s ease; }
    .report-row:hover { background: var(--color-surface, #f8fafc); }

    .badge-active    { background: #dcfce7; color: #16a34a; border: 1px solid #bbf7d0; }
    .badge-inactive  { background: #fee2e2; color: #dc2626; border: 1px solid #fecaca; }
    .badge-running   { background: #dbeafe; color: #2563eb; border: 1px solid #bfdbfe; }
    .badge-error     { background: #fef3c7; color: #d97706; border: 1px solid #fde68a; }

    @@keyframes spin { to { transform: rotate(360deg); } }
    .spinner { animation: spin 0.7s linear infinite; }

    #confirmModal {
        display: none;
        animation: fadeIn 0.15s ease forwards;
    }
    #confirmModal.open { display: flex; }
    #confirmBox {
        animation: slideUp 0.22s cubic-bezier(0.34, 1.4, 0.64, 1) forwards;
    }
</style>

@* -- Page header -- *@
<div class="flex items-center justify-between mb-6 fade-up fade-up-1">
    <div>
        <h1 class="text-text-primary text-2xl font-semibold">Reports</h1>
        <p class="text-text-muted text-sm mt-0.5">Create and manage automated database reports.</p>
    </div>
    <a href="/Dashboard/Reports/Add"
       class="flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700
              text-white text-sm font-medium rounded-xl transition-colors shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M12 5v14M5 12h14"/>
        </svg>
        Add Report
    </a>
</div>

@* -- Alert area -- *@
<div id="alertArea" class="hidden mb-4"></div>

@* -- Reports table card -- *@
<div class="bg-surface-card border border-border rounded-2xl shadow-sm overflow-hidden fade-up fade-up-2">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-border bg-surface">
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide">Name</th>
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide hidden sm:table-cell">Format</th>
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide">Status</th>
                    <th class="text-left text-xs font-semibold text-text-muted px-5 py-3 uppercase tracking-wide">Actions</th>
                </tr>
            </thead>
            <tbody id="reportsTableBody">
                <tr>
                    <td colspan="4" class="text-center py-12 text-text-muted">
                        <svg class="w-5 h-5 mx-auto mb-2 spinner text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                        </svg>
                        <span class="text-xs">Loading reports...</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    @* Footer count & pagination *@
    <div class="px-5 py-3 border-t border-border bg-surface flex items-center justify-between">
        <span id="reportCount" class="text-xs text-text-muted">--</span>
        <div class="flex items-center gap-2">
            <button id="prevPageBtn" onclick="loadPrevPage()" disabled
                    class="px-3 py-1.5 text-xs font-medium rounded-lg border border-border text-text-secondary 
                           hover:bg-surface disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
                Previous
            </button>
            <span id="pageInfo" class="text-xs text-text-muted px-2">Page 1</span>
            <button id="nextPageBtn" onclick="loadNextPage()" disabled
                    class="px-3 py-1.5 text-xs font-medium rounded-lg bg-blue-600 text-white 
                           hover:bg-blue-700 disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
                Next
            </button>
        </div>
    </div>
</div>

@* ============== CONFIRM MODAL ============== *@
<div id="confirmModal"
     class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm items-center justify-center px-4">
    <div id="confirmBox"
         class="bg-surface-card border border-border rounded-2xl shadow-xl w-full max-w-sm px-6 py-6">
        <div id="confirmIcon" class="w-10 h-10 rounded-full flex items-center justify-center mx-auto mb-4"></div>
        <h3 id="confirmTitle" class="text-text-primary font-semibold text-base text-center mb-1"></h3>
        <p id="confirmMessage" class="text-text-muted text-sm text-center mb-5"></p>
        <div class="flex gap-3">
            <button onclick="closeConfirm()"
                    class="flex-1 py-2 text-sm text-text-secondary border border-border rounded-xl hover:bg-surface transition-colors">
                Cancel
            </button>
            <button id="confirmActionBtn"
                    class="flex-1 py-2 text-sm font-medium text-white rounded-xl transition-colors">
                Confirm
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let allReports = [];
    let pendingAction = null;

    // Pagination state
    let currentPage = 1;
    const pageSize = 25;
    let totalReportsCount = 0;
    let totalPages = 1;
    let isLoading = false;

    // ══════════════════════════════════════════════════════════════════════
    // LOAD DATA
    // ══════════════════════════════════════════════════════════════════════

    async function loadData(page = 1) {
        if (isLoading) return;
        isLoading = true;
        currentPage = page;

        const tbody = document.getElementById('reportsTableBody');
        tbody.innerHTML = `
            <tr>
                <td colspan="4" class="text-center py-12 text-text-muted">
                    <svg class="w-5 h-5 mx-auto mb-2 spinner text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                    </svg>
                    <span class="text-xs">Loading reports...</span>
                </td>
            </tr>`;

        try {
            const reportsRes = await fetch(`/Dashboard/Reports/GetAll?page=${page}&pageSize=${pageSize}`);
            if (!reportsRes.ok) throw new Error('Failed to fetch');

            const reportsData = await reportsRes.json();

            allReports = reportsData.data || [];
            totalReportsCount = reportsData.total || 0;
            totalPages = reportsData.totalPages || 1;

            renderTable(allReports);
            updatePaginationControls();
        } catch (err) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="text-center py-12 text-text-muted text-xs">
                        Failed to load reports. Please refresh the page.
                    </td>
                </tr>`;
        } finally {
            isLoading = false;
            updatePaginationControls();
        }
    }

    function loadNextPage() {
        if (currentPage < totalPages) {
            loadData(currentPage + 1);
        }
    }

    function loadPrevPage() {
        if (currentPage > 1) {
            loadData(currentPage - 1);
        }
    }

    function updatePaginationControls() {
        const countEl = document.getElementById('reportCount');
        const pageInfo = document.getElementById('pageInfo');
        const prevBtn = document.getElementById('prevPageBtn');
        const nextBtn = document.getElementById('nextPageBtn');

        const start = totalReportsCount === 0 ? 0 : (currentPage - 1) * pageSize + 1;
        const end = Math.min(currentPage * pageSize, totalReportsCount);

        countEl.textContent = `${totalReportsCount} report${totalReportsCount !== 1 ? 's' : ''} total`;
        pageInfo.textContent = totalReportsCount === 0
            ? 'Page 0 of 0'
            : `Page ${currentPage} of ${totalPages} (${start}-${end})`;

        prevBtn.disabled = currentPage <= 1 || isLoading;
        nextBtn.disabled = currentPage >= totalPages || isLoading;
    }

    // ══════════════════════════════════════════════════════════════════════
    // RENDER TABLE
    // ══════════════════════════════════════════════════════════════════════

    function renderTable(reports) {
        const tbody = document.getElementById('reportsTableBody');

        if (reports.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="text-center py-12 text-text-muted text-xs">
                        No reports found. Add one to get started.
                    </td>
                </tr>`;
            return;
        }

        tbody.innerHTML = reports.map(r => {
            const statusClass = r.status === 'active' ? 'badge-active'
                              : r.status === 'inactive' ? 'badge-inactive'
                              : r.status === 'running' ? 'badge-running'
                              : 'badge-error';

            return `
            <tr class="report-row border-b border-border last:border-0" id="row-${r.id}">
                <td class="px-5 py-3.5">
                    <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 rounded-md bg-blue-50 border border-blue-100 flex items-center justify-center flex-shrink-0">
                            <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
                                <line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                            </svg>
                        </div>
                        <span class="text-text-primary font-medium">${escHtml(r.name)}</span>
                    </div>
                </td>
                <td class="px-5 py-3.5 hidden sm:table-cell">
                    <span class="text-xs px-2 py-0.5 rounded-full border bg-surface text-text-muted border-border uppercase">
                        ${escHtml(r.outputFormat)}
                    </span>
                </td>
                <td class="px-5 py-3.5">
                    <span class="text-xs px-2.5 py-0.5 rounded-full font-medium ${statusClass}">
                        ${escHtml(r.status || 'active')}
                    </span>
                </td>
                <td class="px-5 py-3.5 text-right">
                    <div class="flex items-center justify-end gap-1">
                        <a href="/Dashboard/Reports/${encodeURIComponent(r.name)}"
                           title="View report"
                           class="text-xs px-2.5 py-1.5 rounded-lg border border-border
                                  text-text-secondary hover:border-green-300 hover:text-green-600
                                  hover:bg-green-50 transition-colors">
                            View
                        </a>
                        <a href="/Dashboard/Reports/Edit/${r.id}"
                           title="Edit report"
                           class="text-xs px-2.5 py-1.5 rounded-lg border border-border
                                  text-text-secondary hover:border-blue-300 hover:text-blue-600
                                  hover:bg-blue-50 transition-colors">
                            Edit
                        </a>
                        <button onclick="confirmToggleStatus(${r.id}, '${r.status === 'active' ? 'inactive' : 'active'}')"
                                title="${r.status === 'active' ? 'Deactivate' : 'Activate'}"
                                class="text-xs px-2.5 py-1.5 rounded-lg border transition-colors
                                    ${r.status === 'active'
                                        ? 'border-border text-text-secondary hover:border-amber-300 hover:text-amber-600 hover:bg-amber-50'
                                        : 'border-blue-200 text-blue-600 hover:bg-blue-50'}">
                            ${r.status === 'active' ? 'Deactivate' : 'Activate'}
                        </button>
                        <button onclick="confirmDelete(${r.id}, '${escHtml(r.name)}')"
                                title="Delete report"
                                class="text-xs px-2.5 py-1.5 rounded-lg border border-border
                                       text-text-secondary hover:border-red-300 hover:text-red-600
                                       hover:bg-red-50 transition-colors">
                            Delete
                        </button>
                    </div>
                </td>
            </tr>`;
        }).join('');
    }

    // ══════════════════════════════════════════════════════════════════════
    // UTILITY HELPERS
    // ══════════════════════════════════════════════════════════════════════

    function escHtml(str) {
        return String(str)
            .replace(/&/g,'&amp;').replace(/</g,'&lt;')
            .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ══════════════════════════════════════════════════════════════════════
    // CONFIRM MODAL
    // ══════════════════════════════════════════════════════════════════════

    function openConfirm({ icon, iconBg, title, message, btnColor, action }) {
        document.getElementById('confirmIcon').className =
            `w-10 h-10 rounded-full flex items-center justify-center mx-auto mb-4 ${iconBg}`;
        document.getElementById('confirmIcon').innerHTML = icon;
        document.getElementById('confirmTitle').textContent   = title;
        document.getElementById('confirmMessage').textContent = message;

        const btn = document.getElementById('confirmActionBtn');
        btn.className = `flex-1 py-2 text-sm font-medium text-white rounded-xl transition-colors ${btnColor}`;
        pendingAction = action;
        btn.onclick = () => { pendingAction(); };

        document.getElementById('confirmModal').classList.add('open');
    }

    function closeConfirm() {
        document.getElementById('confirmModal').classList.remove('open');
        pendingAction = null;
    }

    // ══════════════════════════════════════════════════════════════════════
    // DELETE
    // ══════════════════════════════════════════════════════════════════════

    function confirmDelete(reportId, name) {
        openConfirm({
            icon: `<svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                       <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                       <path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/>
                   </svg>`,
            iconBg:   'bg-red-50',
            title:    'Delete Report',
            message:  `Are you sure you want to permanently delete "${name}"? This action cannot be undone.`,
            btnColor: 'bg-red-500 hover:bg-red-600',
            action:   () => deleteReport(reportId)
        });
    }

    async function deleteReport(reportId) {
        closeConfirm();
        try {
            const res = await fetch(`/Dashboard/Reports/Delete/${reportId}`, { method: 'POST' });
            if (!res.ok) throw new Error();

            showAlert('Report deleted successfully.', 'success');
            // Refresh current page so the table stays at 25 items
            loadData(currentPage);
        } catch {
            showAlert('Failed to delete report. Please try again.', 'error');
        }
    }

    // ══════════════════════════════════════════════════════════════════════
    // TOGGLE STATUS
    // ══════════════════════════════════════════════════════════════════════

    function confirmToggleStatus(reportId, newStatus) {
        const actionLabel = newStatus === 'active' ? 'Activate' : 'Deactivate';
        const color = newStatus === 'active' ? 'bg-blue-500 hover:bg-blue-600' : 'bg-amber-500 hover:bg-amber-600';
        openConfirm({
            icon: `<svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                       <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                   </svg>`,
            iconBg:   'bg-blue-50',
            title:    `${actionLabel} Report`,
            message:  `Are you sure you want to ${actionLabel.toLowerCase()} this report?`,
            btnColor: color,
            action:   () => toggleStatus(reportId, newStatus)
        });
    }

    async function toggleStatus(reportId, newStatus) {
        closeConfirm();
        try {
            const res = await fetch(`/Dashboard/Reports/UpdateStatus/${reportId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: newStatus })
            });
            if (!res.ok) throw new Error();
            const report = allReports.find(r => r.id === reportId);
            if (report) report.status = newStatus;
            renderTable(allReports);
            showAlert(`Report ${newStatus === 'active' ? 'activated' : 'deactivated'} successfully.`, 'success');
        } catch {
            showAlert('Failed to update report status. Please try again.', 'error');
        }
    }

    // ══════════════════════════════════════════════════════════════════════
    // ALERT HELPERS
    // ══════════════════════════════════════════════════════════════════════

    function showAlert(message, type) {
        const el = document.getElementById('alertArea');
        const isSuccess = type === 'success';
        el.className = `mb-4 px-4 py-3 rounded-xl text-sm border flex items-center gap-2
            ${isSuccess
                ? 'bg-green-50 text-green-700 border-green-200'
                : 'bg-red-50 text-red-700 border-red-200'}`;
        el.innerHTML = `
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                ${isSuccess
                    ? '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>'
                    : '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>'}
            </svg>
            ${escHtml(message)}`;
        el.classList.remove('hidden');
        setTimeout(() => el.classList.add('hidden'), 4000);
    }

    // ══════════════════════════════════════════════════════════════════════
    // EVENT LISTENERS & INIT
    // ══════════════════════════════════════════════════════════════════════

    document.getElementById('confirmModal').addEventListener('click', function(e) {
        if (e.target === this) closeConfirm();
    });

    // Load on page ready
    loadData();
</script>
}
